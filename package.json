{
  "name": "slovo-russian-vocab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4186",
    "build": "prisma generate && next build && node scripts/prepare_runtime.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests --no-warn-ignored",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "import:vocab": "tsx scripts/import_vocab.ts",
    "seed:demo": "tsx scripts/seed_demo.ts",
    "ocr:prepare": "node scripts/prepare_ocr.mjs",
    "setup": "node scripts/setup.mjs",
    "content:report": "tsx scripts/content_report.ts",
    "content:import": "tsx scripts/import_annotations.ts",
    "demo:reset": "tsx scripts/reset_demo.ts",
    "env:check": "node scripts/check_environment.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:import": "tsx scripts/verify_import.ts",
    "smoke:demo": "node scripts/smoke_demo.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "dexie": "4.4.7",
    "dotenv": "17.2.3",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.34.5",
    "tesseract.js": "7.0.0",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "typescript-eslint": "8.72.0",
    "@next/eslint-plugin-next": "16.4.3",
    "eslint-plugin-react-hooks": "7.1.1"
  }
}
